{
  "name": "meco-mission-control-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundle": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit --force",
    "test": "jest",
    "test:ci": "jest --ci --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:security-workflows": "node --test ./scripts/merge-requirements-gate.test.mjs",
    "test:app-utils": "jest src/lib/__tests__/appUtils.test.ts src/lib/__tests__/appUtilsSelection.test.ts src/lib/__tests__/appUtilsManufacturing.test.ts src/lib/__tests__/workspaceNavigation.test.ts",
    "verify-contracts": "node ./scripts/verify-bootstrap-contract.mjs",
    "verify": "npm run verify-contracts && npm run test:security-workflows && npm run typecheck && npm run lint && npm run test:ci && npm run build:bundle"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "brace-expansion@>=3.0.0 <5.0.9": "5.0.9"
  }
}
