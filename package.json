{
  "name": "meco-mission-control-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundle": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit --force",
    "test": "jest",
    "test:ci": "jest --ci --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:security-workflows": "node --test ./scripts/merge-requirements-gate.test.mjs",
    "test:app-utils": "jest src/lib/__tests__/appUtils.test.ts src/lib/__tests__/appUtilsSelection.test.ts src/lib/__tests__/appUtilsManufacturing.test.ts src/lib/__tests__/workspaceNavigation.test.ts",
    "verify-contracts": "node ./scripts/verify-bootstrap-contract.mjs",
    "verify": "npm run verify-contracts && npm run test:security-workflows && npm run typecheck && npm run lint && npm run test:ci && npm run build:bundle"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^1.48.0",
    "occt-import-js": "^0.0.23",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "brace-expansion@<1.1.21": "1.1.21",
    "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
    "brace-expansion@>=3.0.0 <5.0.12": "5.0.12"
  }
}
